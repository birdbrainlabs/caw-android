<?xml version="1.0" encoding="utf-8"?>
<!-- DictationActivity on its side: transcript on the left, the hold column on the right.
     Same ids as layout/activity_dictation.xml. No ScrollView around Crumb (it would end a hold). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caw_backdrop"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/transcript_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/transcript_background"
                android:fillViewport="true"
                android:padding="16dp">

                <TextView
                    android:id="@+id/transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/dictation_hint"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/caw_text"
                    android:textColorHint="#80F2F4F7"
                    android:textIsSelectable="true"
                    android:textSize="18sp" />
            </ScrollView>

            <!-- Send to computer on: the transcript gives way to the last text sent and the computer's
                 key row and shortcut buttons (rows of R.integer.shortcut_columns, added at runtime). -->
            <LinearLayout
                android:id="@+id/shortcut_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sent_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/caw_text"
                    android:textSize="14sp" />

                <!-- ← ↑ ↓ → Backspace Enter, fixed above the scrolling grid. -->
                <include layout="@layout/dictation_key_row" />

                <ScrollView
                    android:id="@+id/shortcut_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/shortcut_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/shortcuts_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/dictation_shortcuts_empty"
                    android:textColor="@color/caw_text"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- Opens the paired computer's touchpad (TouchpadActivity); dimmed while none is paired. -->
                <TextView
                    android:id="@+id/touchpad"
                    style="@style/CawButton"
                    android:text="@string/dictation_touchpad" />

                <!-- Opens Settings (SettingsActivity). On its side it sits by Touchpad; upright, by the Computer row. -->
                <TextView
                    android:id="@+id/settings"
                    style="@style/CawButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/dictation_settings" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/copy"
                    style="@style/CawButton"
                    android:text="@string/dictation_copy" />

                <TextView
                    android:id="@+id/clear"
                    style="@style/CawButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/dictation_clear" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="3"
                android:minHeight="48dp"
                android:textColor="@color/caw_text"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/crumb_slot"
                android:layout_width="150dp"
                android:layout_height="150dp">

                <ProgressBar
                    android:id="@+id/spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/computer_row"
                style="@style/CawButton"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
