<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsActivity on its side: the computer and its word fixes on the left, the touchpad
     settings on the right, each column scrolling on its own. Same ids as layout/activity_settings.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caw_backdrop"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_title"
                android:textColor="@color/caw_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/computer_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"
                android:textColor="@color/caw_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_fixes_title"
                android:textColor="@color/caw_text"
                android:textSize="18sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/settings_fixes_help"
                android:textColor="@color/caw_text"
                android:textSize="13sp" />

            <!-- Rows (layout/settings_fix_row.xml) are added at runtime, sorted by what it hears. -->
            <LinearLayout
                android:id="@+id/fix_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/fixes_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:text="@string/settings_fixes_empty"
                android:textColor="@color/caw_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/add_fix"
                style="@style/CawButton"
                android:layout_marginTop="12dp"
                android:text="@string/settings_fix_add" />
            <TextView
                android:id="@+id/fixes_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:textColor="@color/caw_text"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_touchpad_title"
                android:textColor="@color/caw_text"
                android:textSize="18sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/settings_pointer_help"
                android:textColor="@color/caw_text"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_speed"
                    android:textColor="@color/caw_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/caw_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="99"
                android:minHeight="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/accel_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_accel"
                    android:textColor="@color/caw_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/accel_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/caw_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/accel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:minHeight="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
            <TextView
                android:id="@+id/pointer_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:textColor="@color/caw_text"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:visibility="gone" />

            <Switch
                android:id="@+id/natural_scrolling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="@string/settings_natural"
                android:textColor="@color/caw_text"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/settings_natural_help"
                android:textColor="@color/caw_text"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
