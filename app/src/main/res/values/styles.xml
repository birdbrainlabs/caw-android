<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The dictation screen's buttons: the pill's Keyboard button look, at a 48 dp touch height. -->
    <style name="CawButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/keyboard_button</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/caw_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- The dictation screen's fixed key row: shares the row by weight, so it fits a 360 dp phone;
         the text shrinks rather than clipping at large font sizes. -->
    <style name="CawKeyRowButton" parent="CawButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
    </style>
</resources>
