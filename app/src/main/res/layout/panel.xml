<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/caw_backdrop"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:maxLines="3"
                android:minHeight="48dp"
                android:textColor="@color/caw_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/keyboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/keyboard_button"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/keyboard_button"
                android:textColor="@color/caw_text"
                android:textSize="12sp" />

            <!-- Send to computer: special keys for the paired computer. Shown only while that mode is on. -->
            <LinearLayout
                android:id="@+id/remote_keys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/remote_backspace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/keyboard_button"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/backspace_button"
                    android:textColor="@color/caw_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/remote_enter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/keyboard_button"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/enter_button"
                    android:textColor="@color/caw_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Crumb (ui/CrumbView, kept alive by ui/CrumbHost) is added here at runtime, under the
             spinner. The spinner only shows when the plain orb has replaced Crumb. -->
        <FrameLayout
            android:id="@+id/crumb_slot"
            android:layout_width="168dp"
            android:layout_height="168dp">

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
