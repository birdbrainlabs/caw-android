<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (SettingsActivity): the computer's word fixes, shortcuts (v4) and pointer, and the
     phone-only natural scrolling switch. Same ids as layout-land/activity_settings.xml. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caw_backdrop"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_title"
            android:textColor="@color/caw_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/computer_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawablePadding="8dp"
            android:textColor="@color/caw_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_fixes_title"
            android:textColor="@color/caw_text"
            android:textSize="18sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/settings_fixes_help"
            android:textColor="@color/caw_text"
            android:textSize="13sp" />

        <!-- Rows (layout/settings_fix_row.xml) are added at runtime, sorted by what it hears. -->
        <LinearLayout
            android:id="@+id/fix_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/fixes_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:text="@string/settings_fixes_empty"
            android:textColor="@color/caw_text"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/add_fix"
            style="@style/CawButton"
            android:layout_marginTop="12dp"
            android:text="@string/settings_fix_add" />
        <TextView
            android:id="@+id/fixes_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:textColor="@color/caw_text"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_shortcuts_title"
            android:textColor="@color/caw_text"
            android:textSize="18sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/settings_shortcuts_help"
            android:textColor="@color/caw_text"
            android:textSize="13sp" />

        <!-- Rows (layout/settings_shortcut_row.xml) are added at runtime, in the computer's order. -->
        <LinearLayout
            android:id="@+id/shortcut_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- "No shortcuts yet." or, for a Caw Desktop older than 0.3, that it has none. -->
        <TextView
            android:id="@+id/shortcuts_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:textColor="@color/caw_text"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/add_shortcut"
            style="@style/CawButton"
            android:layout_marginTop="12dp"
            android:text="@string/settings_shortcut_add" />
        <TextView
            android:id="@+id/shortcuts_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:textColor="@color/caw_text"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_touchpad_title"
            android:textColor="@color/caw_text"
            android:textSize="18sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/settings_pointer_help"
            android:textColor="@color/caw_text"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speed_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_speed"
                android:textColor="@color/caw_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/caw_text"
                android:textSize="16sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            android:minHeight="48dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/accel_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_accel"
                android:textColor="@color/caw_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/accel_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/caw_text"
                android:textSize="16sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/accel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:minHeight="48dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
        <TextView
            android:id="@+id/pointer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:textColor="@color/caw_text"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <Switch
            android:id="@+id/natural_scrolling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/settings_natural"
            android:textColor="@color/caw_text"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/settings_natural_help"
            android:textColor="@color/caw_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
