<?xml version="1.0" encoding="utf-8"?>
<!-- TouchpadActivity: the paired computer's touchpad, with Crumb, Backspace and Enter under it.
     No ScrollView anywhere: a scrolling parent would take a moving finger. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caw_backdrop"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Connected to omarchy / Reconnecting to omarchy… / can't move the mouse. -->
        <TextView
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="32dp"
            android:textColor="@color/caw_text"
            android:textSize="15sp" />

        <!-- The touch area: every finger here goes to TouchGestures. -->
        <FrameLayout
            android:id="@+id/touch_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/transcript_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="24dp"
                android:text="@string/touchpad_hint"
                android:textColor="#80F2F4F7"
                android:textSize="15sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="40dp"
            android:textColor="@color/caw_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/remote_backspace"
                style="@style/CawButton"
                android:text="@string/backspace_button" />

            <!-- Crumb (ui/CrumbView, kept alive by ui/CrumbHost) is added here at runtime. -->
            <FrameLayout
                android:id="@+id/crumb_slot"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <ProgressBar
                    android:id="@+id/spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/remote_enter"
                style="@style/CawButton"
                android:text="@string/enter_button" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
