<?xml version="1.0" encoding="utf-8"?>
<!-- Send to computer: pairing and the switch (ComputerActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caw_backdrop"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/computer_title"
            android:textColor="@color/caw_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/caw_text"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/send_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/computer_switch"
            android:textColor="@color/caw_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/computer_switch_help"
            android:textColor="@color/caw_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/forget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/computer_forget" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/computer_pair_title"
            android:textColor="@color/caw_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:text="@string/computer_pair_help"
            android:textColor="@color/caw_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/computer_scan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/computer_or_type"
            android:textColor="@color/caw_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/computer_host_hint"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:minHeight="48dp"
            android:textColor="@color/caw_text"
            android:textColorHint="#80F2F4F7" />

        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/computer_port_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="48dp"
            android:text="47820"
            android:textColor="@color/caw_text"
            android:textColorHint="#80F2F4F7" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/computer_code_hint"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
            android:minHeight="48dp"
            android:textColor="@color/caw_text"
            android:textColorHint="#80F2F4F7" />

        <Button
            android:id="@+id/pair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/computer_pair" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/caw_text"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
